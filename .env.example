# Скопируйте в .env: cp .env.example .env
# Все значения ниже подходят для запуска в docker compose (сеть app-network).

# --- PostgreSQL (pgvector) ---
# Внутри compose имя сервиса БД — postgres, снаружи (локальный запуск) — localhost.
# Пароль должен совпадать с POSTGRES_PASSWORD в Database/.env и Notifications/.env.
DATABASE_URL=postgresql+psycopg://postgres:change-me@postgres:5432/tasks_db

# --- GigaChat ---
# Authorization key из личного кабинета, scope GIGACHAT_API_PERS.
# Без него LLM-функции (разбор сообщений, напоминания, поиск) не работают.
CREDENTIAL=

# --- Соседние сервисы (значения по умолчанию подходят, можно не задавать) ---
VK_BOT_URL=http://vkbottle_bot
NOTIFICATIONS_URL=http://notifications:8080

# --- Необязательно ---
# Модель эмбеддингов для поиска по заголовкам (по умолчанию эта же; 768 измерений)
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
